{
  "name": "tasks-ops-tool",
  "version": "0.1.0-alpha.0",
  "description": "Headless Markdown-first task operations service for humans, agents, and apps.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "keywords": [
    "tasks",
    "markdown",
    "agents",
    "automation",
    "sqlite",
    "task-management"
  ],
  "license": "UNLICENSED"
}
