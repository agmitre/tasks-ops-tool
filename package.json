{
  "name": "tasks-ops-tool",
  "version": "0.1.0-alpha.0",
  "description": "Headless Markdown-first task operations service for humans, agents, and apps.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:mcp": "tsx src/mcp/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:mcp": "node dist/mcp/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "keywords": [
    "tasks",
    "markdown",
    "agents",
    "automation",
    "sqlite",
    "task-management",
    "mcp"
  ],
  "license": "UNLICENSED"
}
